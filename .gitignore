# =============================================================================
# STRIKECAST .gitignore
# Regla general: solo entra al repo lo que NECESITA el deploy en Docker/Vercel.
# Todo lo demás (scratch, exploratorio, cache, raw data histórica) se queda local.
# =============================================================================

# --- Runtime / logs ---
*.log
*.err.log
uvicorn-*.log
uvicorn-*.err.log
logs/
tmp_out.txt
_*.txt
_*.log

# --- Python cache ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Virtual envs ---
.venv/
venv/
env/
.env
.env.local
.env.*.local

# --- Editor / OS ---
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# --- Herramientas locales / agentes ---
.agents/
.codex/
.claude/
memory/

# --- Zips y binarios grandes ---
*.zip
*.7z
*.tar.gz

# --- Marcadores diarios de la CLI (archivos de 27 bytes con fecha) ---
/2023-*
/2024-*
/2025-*
/2026-*
/log_loss

# --- Frontend alterno (viejo, StatsMLB es el frontend real) ---
frontend/
backend/
vercel/

# --- Carpetas exploratorias / scratch (no deploy) ---
AUDITREGRESSION/
STARTFROMTHEEND/
work/
outputs/
analysis/*
!analysis/mlb_three_game_sweep_report.py
tests/
docs/
sim/
notebooks/

# --- App NFL original (650 MB / 11k archivos, se queda local para el exportador) ---
StatsMLB/StrikeCast NFL/

# --- Data raw (40 GB de JSONs históricos, se quedan local) ---
data/raw/
data/savant/
backend/data/raw/
backend/data/savant/

